PORT=3001
# Obligatorio en producción: mínimo 32 caracteres aleatorios (el servidor no arranca si falta o es débil).
# Genera uno con: openssl rand -base64 48
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
DATABASE_URL=postgres://user:password@localhost:5432/hotel_manager
# Orígenes permitidos para CORS y para peticiones state-changing (separados por coma, sin barra final).
CORS_ORIGIN=http://localhost:3000
# Permite registro público cuando ya existen usuarios. En producción el valor
# por defecto es false: solo se permite el bootstrap del primer usuario (admin).
ALLOW_REGISTRATION=false
# IP(s)/CIDR del proxy inverso de confianza (separadas por coma). Si no se define,
# no se confía en cabeceras X-Forwarded-*. En despliegues tras proxy, configúralo
# (p. ej. TRUST_PROXY=127.0.0.1 o TRUST_PROXY=10.0.0.0/8) para que el rate limiting
# use la IP real del cliente. En Render suele ser TRUST_PROXY=true.
TRUST_PROXY=
